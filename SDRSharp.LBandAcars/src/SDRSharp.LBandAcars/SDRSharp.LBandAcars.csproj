<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SDRSharp.LBandAcars</AssemblyName>
    <RootNamespace>SDRSharp.LBandAcars</RootNamespace>
    <Platforms>AnyCPU</Platforms>
    <Description>Classic Aero L-band ACARS decoder for 600, 1200 and 10500 bit/s.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="SDRSharp.Common">
      <HintPath>..\..\lib\SDRSharp.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SDRSharp.PanView">
      <HintPath>..\..\lib\SDRSharp.PanView.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SDRSharp.Radio">
      <HintPath>..\..\lib\SDRSharp.Radio.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
